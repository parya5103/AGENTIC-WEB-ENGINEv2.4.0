# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VERCEL_TOKEN: Required for automatic publishing to Vercel.
VERCEL_TOKEN=

# ADSENSE_KEY: Required for AdSense Management API integration.
ADSENSE_KEY=
ADSENSE_PUBLISHER_ID=
ADSENSE_CLIENT_ID=

# QWEN_API_KEY: Required for Qwen Coder integration.
# Use a provider like DashScope (https://dashscope.console.aliyun.com) or OpenRouter.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# NVIDIA_API_KEY: Required for NVIDIA AI endpoints (e.g. Nemotron)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
