{
  "entities": {
    "Asset": {
      "title": "Asset",
      "description": "A generated niche website asset",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "niche": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "selectedReason": { "type": "string" },
            "targetAudience": { "type": "string" },
            "estimatedCPC": { "type": "string" },
            "competitionLvl": { "type": "string" }
          }
        },
        "structure": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "tagline": { "type": "string" },
            "pages": { "type": "array", "items": { "type": "string" } },
            "colors": { "type": "object" },
            "typography": { "type": "string" }
          }
        },
        "variants": { "type": "array" },
        "articles": { "type": "array" },
        "stats": {
          "type": "object",
          "properties": {
            "traffic": { "type": "number" },
            "revenue": { "type": "number" },
            "growth": { "type": "number" }
          }
        },
        "abTests": { "type": "array" },
        "persona": { "type": "object" },
        "reliability": { "type": "object" },
        "url": { "type": "string" },
        "isDeployed": { "type": "boolean" },
        "isDeploying": { "type": "boolean" },
        "deployProgress": { "type": "number" },
        "deployStatus": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "thinkingTrace": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "title", "niche", "createdAt"]
    },
    "Log": {
      "title": "Log",
      "description": "An agent execution log entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "agent": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "error", "process"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "agent", "message", "type", "timestamp"]
    },
    "GlobalStats": {
      "title": "Global Stats",
      "description": "Aggregated metrics for a user's network",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "totalRevenue": { "type": "number" },
        "totalTraffic": { "type": "number" },
        "activeSites": { "type": "number" },
        "dailyGrowth": { "type": "number" },
        "simulationEnabled": { "type": "boolean" },
        "history": { "type": "array" }
      }
    },
    "Config": {
      "title": "Config",
      "description": "System configuration parameters",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "publisherId": { "type": "string" },
        "clientId": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}/assets/{assetId}": {
      "schema": "Asset",
      "description": "Collection of generated niche sites"
    },
    "/users/{userId}/logs/{logId}": {
      "schema": "Log",
      "description": "Audit trail of agent activity"
    },
    "/users/{userId}/stats/global": {
      "schema": "GlobalStats",
      "description": "Global network metrics singleton"
    },
    "/users/{userId}/config/adsense": {
      "schema": "Config",
      "description": "Ad network configuration singleton"
    }
  }
}
